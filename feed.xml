3 mt-3 mt-md-0"> <a href="/portfolio/assets/img/grad2.jpg" data-lightbox="grad-gallery" data-title=""> <figure> <picture> <source class="responsive-img-srcset" srcset="/portfolio/assets/img/grad2-480.webp 480w,/portfolio/assets/img/grad2-800.webp 800w,/portfolio/assets/img/grad2-1400.webp 1400w," type="image/webp" sizes="95vw"/> <img src="/portfolio/assets/img/grad2.jpg" class="img-fluid rounded z-depth-1" width="100%" height="auto" loading="eager" onerror="this.onerror=null; document.querySelectorAll('.responsive-img-srcset').forEach(function (n) { n.remove(); });"/> </picture> </figure> </a> </div> <div class="col-sm-6 col-md-3 mt-3 mt-md-0"> <a href="/portfolio/assets/img/grad3.jpg" data-lightbox="grad-gallery" data-title=""> <figure> <picture> <source class="responsive-img-srcset" srcset="/portfolio/assets/img/grad3-480.webp 480w,/portfolio/assets/img/grad3-800.webp 800w,/portfolio/assets/img/grad3-1400.webp 1400w," type="image/webp" sizes="95vw"/> <img src="/portfolio/assets/img/grad3.jpg" class="img-fluid rounded z-depth-1" width="100%" height="auto" loading="eager" onerror="this.onerror=null; document.querySelectorAll('.responsive-img-srcset').forEach(function (n) { n.remove(); });"/> </picture> </figure> </a> </div> <div class="col-sm-6 col-md-3 mt-3 mt-md-0"> <a href="/portfolio/assets/img/grad4.jpg" data-lightbox="grad-gallery" data-title="My visit to Dal in Grade 11 (2019) and my graduation (2024)"> <figure> <picture> <source class="responsive-img-srcset" srcset="/portfolio/assets/img/grad4-480.webp 480w,/portfolio/assets/img/grad4-800.webp 800w,/portfolio/assets/img/grad4-1400.webp 1400w," type="image/webp" sizes="95vw"/> <img src="/portfolio/assets/img/grad4.jpg" class="img-fluid rounded z-depth-1" width="100%" height="auto" loading="eager" onerror="this.onerror=null; document.querySelectorAll('.responsive-img-srcset').forEach(function (n) { n.remove(); });"/> </picture> </figure> </a> </div> </div>]]></content><author><name></name></author><summary typ